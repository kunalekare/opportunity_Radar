# ==============================================================================
# Opportunity Radar - Environment Configuration (.env.example)
# ==============================================================================

# Database (PostgreSQL + pgvector)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=opportunity_radar
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/opportunity_radar

# JWT Security
SECRET_KEY=change-this-to-a-very-long-random-secret-key-in-production-min32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Anthropic Claude AI
# The AI agent uses Anthropic Claude to parse resumes, score opportunities, and generate tailored application drafts.
# Model name comes from env var CLAUDE_MODEL (default: claude-sonnet-5-5).
# Never hardcode the API key in source control.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-sonnet-5-5

# Web Push Notifications (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=notifications@opportunityradar.app

# Optional Notification Channels (Phase 3)
TELEGRAM_BOT_TOKEN=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=alerts@opportunityradar.app

# Frontend Client Config
VITE_API_URL=http://localhost:8000/api/v1
