# ==============================================================================
# Opportunity Radar - Environment Configuration (.env.example)
# ==============================================================================

# Database (PostgreSQL + pgvector)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=opportunity_radar
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/opportunity_radar

# JWT Security
SECRET_KEY=change-this-to-a-very-long-random-secret-key-in-production-min32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Anthropic Claude AI
# Used for resume parsing, un-structured opportunity normalization, and scoring.
# Model name comes from env var CLAUDE_MODEL (default: claude-sonnet-5-5).
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-sonnet-5-5

# Ingestion & Scheduler Settings
DEMO_MODE=false
MAX_OPPORTUNITY_AGE_DAYS=45
DEFAULT_INGESTION_INTERVAL_HOURS=3

# --- Adapter Credentials ---

# Adzuna API (Jobs/Internships, India + Global)
# Free developer keys: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in

# GitHub API (Open source collaborations and issues)
# Token: https://github.com/settings/tokens (public repo read only)
GITHUB_TOKEN=

# Reddit API (r/forhire, r/internships)
# Credentials: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=OpportunityRadar:v1.0 (by /u/opportunityradar)

# Dedicated IMAP Email Alerts (LinkedIn, Internshala, Naukri, Unstop forwarding)
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your-alerts-inbox@gmail.com
IMAP_PASSWORD=your-google-app-password
IMAP_FOLDER=INBOX

# Pluggable Embeddings Provider
EMBEDDING_PROVIDER=mock
EMBEDDING_API_KEY=

# Web Push Notifications (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=notifications@opportunityradar.app

# Frontend Client Config
VITE_API_URL=http://localhost:8000/api/v1
